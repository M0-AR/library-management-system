# ── Core ─────────────────────────────────────────────────────────────
# Public origin of the app (used in links, checkout redirects, host detection)
PUBLIC_APP_URL=http://localhost
# The primary app domain (custom white-label tenant domains are anything else)
APP_DOMAIN=localhost
# Email used for automatic HTTPS certificates (production)
ACME_EMAIL=admin@example.com

# ── Postgres ─────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=library
# Runtime role used by the application. NEVER make this the table owner.
APP_DB_ROLE=app_user
APP_DB_PASSWORD=change-me-app

# ── Backend ──────────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_ENABLED=true
# Optional: enables Redis-backed rate limiting and caching
REDIS_URL=redis://redis:6379

# ── Billing ──────────────────────────────────────────────────────────
# stub | paddle
BILLING_PROVIDER=stub
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_GROWTH=
PADDLE_PRICE_ENTERPRISE=

# ── Email (optional — notifications are recorded in-app either way) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Library Cloud <no-reply@example.com>

# ── Frontend ─────────────────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=4000
