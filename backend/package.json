{
  "name": "@library-cloud/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Library Cloud API — multi-tenant library management SaaS",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/db && cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/main.js",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bootstrap": "tsx --env-file-if-exists=.env src/scripts/bootstrap.ts",
    "seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.2.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-fastify": "^12.1.3",
    "@nestjs/schedule": "^12.0.2",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.1.6",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
