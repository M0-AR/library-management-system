# Local development (pnpm dev) — points at the dockerized postgres/redis from `make db-dev`
NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://app_user:change-me-app@localhost:5432/library
DATABASE_URL_ADMIN=postgres://postgres:change-me-postgres@localhost:5432/library
APP_DB_ROLE=app_user
APP_DB_PASSWORD=change-me-app
POSTGRES_DB=library
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379
RATE_LIMIT_ENABLED=true
LOG_LEVEL=debug
PUBLIC_APP_URL=http://localhost:3000
APP_DOMAIN=localhost

BILLING_PROVIDER=stub
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Library Cloud <no-reply@example.com>
